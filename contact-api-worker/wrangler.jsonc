{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cleargate-contact-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "CONTACT_TO": "contact@cleargateaccess.com",
    "CONTACT_FROM": "ClearGate Website <website@cleargateaccess.com>",
    "ALLOWED_ORIGINS": "https://cleargateaccess.com,https://www.cleargateaccess.com",
    "TURNSTILE_EXPECTED_HOSTNAMES": "cleargateaccess.com,www.cleargateaccess.com"
  },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "contact-api.cleargateaccess.com",
      "custom_domain": true
    }
  ]
}
